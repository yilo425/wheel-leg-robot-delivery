//=============================================================================
// project_config.vh  --  全局参数宏
//-----------------------------------------------------------------------------
// 项目 : 轮足复合式 FPGA 实时感知与自主控制机器人
// 竞赛 : 2026 全国大学生嵌入式芯片与系统设计竞赛 - FPGA 创新设计赛道
// 平台 : 高云 ACG720 (GW5A-25A) / 小梅哥开发板
//-----------------------------------------------------------------------------
// 约定 :
//   1) 时间相关参数全部以 "时钟周期数" 为单位通过 parameter 下发,
//      本文件只放与具体模块无关的全局量。
//   2) 本文件使用 `define 而非 parameter, 因此在 Gowin IDE 与 ModelSim 中
//      均通过 +incdir 或工程 include 路径生效, 不参与端口传递。
//   3) 禁止魔法数字: 任何频率/波特率/窗口长度必须来自本文件或模块 parameter。
//=============================================================================

`ifndef PROJECT_CONFIG_VH
`define PROJECT_CONFIG_VH

//-----------------------------------------------------------------------------
// 全局宏: 用 "值来自 parameter、单位来自注释" 的方式避免重复定义
//-----------------------------------------------------------------------------
`define CFG_INFO            "wheellegged-robot/ACG720"

//--------------------------------------------------------------------------------
// 默认系统时钟
//   小梅哥 ACG720 板载 50MHz 有源晶振 -> gowin_pll -> 100MHz 系统时钟
//   SYS_CLK_HZ 填 PLL 输出频率, 全工程所有分频都由它推导
//--------------------------------------------------------------------------------
`define SYS_CLK_HZ_DEFAULT  100_000_000

//-----------------------------------------------------------------------------
// 复位
//   按键低有效, 需同步释放
//-----------------------------------------------------------------------------
`define RST_DEBOUNCE_CYCLES 1_000_000  // 10ms @100MHz

//-----------------------------------------------------------------------------
// UART
//   1 路给 PC 调试打印, 1 路给 ARM 视觉模块 (协议见 doc/uart_frame_protocol.md)
//-----------------------------------------------------------------------------
`define UART_BAUD_DEFAULT   115_200

//-----------------------------------------------------------------------------
// 电机 PWM
//   20kHz: 超出人耳可听范围, 且远高于电机电气时间常数, 电流纹波可接受
//   DUTY_GAIN 决定 duty_in 的满量程: 满占空比 = PERIOD_CNT*DUTY_GAIN
//-----------------------------------------------------------------------------
`define PWM_FREQ_HZ_DEFAULT 20_000
`define PWM_DUTY_GAIN       128

//-----------------------------------------------------------------------------
// 编码器
//   SPEED_WINDOW_CYCLES 决定测速刷新率, 10ms 窗口 -> 100Hz 速度输出
//-----------------------------------------------------------------------------
`define ENC_SPEED_WINDOW_CYCLES  1_000_000  // 10ms @100MHz
`define ENC_POS_WIDTH            32
`define ENC_SPEED_WIDTH          24

//-----------------------------------------------------------------------------
// 板级资源映射 (与 constraints/*.cst 保持一致, 改引脚时两边同时改)
//-----------------------------------------------------------------------------
`define BOARD_LED_WIDTH        4
`define BOARD_KEY_WIDTH        2

`endif // PROJECT_CONFIG_VH
