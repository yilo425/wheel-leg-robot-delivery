//=============================================================================
// stop_block.scad —— 挡件 v2（每腿 1 个，×4）
//
// ★ v2 为什么和 v1 不一样：
//   v1 是「从底板下面竖着拧 2 颗螺丝」——但腿在【墙外】转，挡件必须装在墙外，
//   底板够不着。v5 车身改成在侧壁外面做 16×14×6 的凸台 + 2 个 M3 底孔，
//   所以挡件改成【横着拧进凸台】。
//
// ★ 高度怎么调：螺丝孔做成【竖向长槽 16mm】，松开螺丝上下滑动 →
//   不用垫片，±8mm 连续可调（v1 的垫片方案作废）。
//
// 配合车身（mech/body_v5.scad 的 stop_boss / stop_boss_holes）：
//     凸台  16(X) × 6(Y) × 14(Z)，外表面 y = 81（W/2+6）
//     底孔  φ2.8，z = 30，x = ±55 ± 4.5（孔距 9）
//
// 装法：
//   1) 挡件贴凸台外表面（y=81），伸出墙外到 y=91
//   2) 2× M3×16 自攻，从挡件外侧拧进去（穿过挡件 10mm + 凸台 6mm）
//   3) 底面贴 3mm 橡胶（槽带 1.2 挡边，橡胶不会掉）
//   4) 松开螺丝 → 上下滑到"腿在工作角 45° 时刚好顶住" → 拧紧
//
// 受力：约 8.4 N（0.85 kg），PETG 100% 填充余量很大 ✓
//
// 打印：PETG / 0.2 / 100% 填充 / 底面朝下平躺 / 无支撑
//=============================================================================

// ---------------- 参数 + 模块（都在 lib 里）----------------
//   用 include 而不是 use：use 不导入顶层变量，挡件会读成 W=D=H=0。
include <stop_block_lib.scad>

SHOW_ALL = true;  // true = 一次排 4 个（方便一次打完）

// 4 个一排（间距 20）
if (SHOW_ALL)
    for (i = [0 : 3]) translate([i * (W + 6), 0, 0]) stop_block();
else
    stop_block();
