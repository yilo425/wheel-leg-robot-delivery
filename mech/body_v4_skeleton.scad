//=============================================================================
// body_v4_skeleton.scad —— 统一建模 + 分开建模的"正确结构"演示
//
// ★ 这个文件的重点不是形状，是【结构】：
//     一个 PART 参数同时支持三种输出：
//       "assembly" → 两层叠起来看（检查干涉）
//       "lower"    → 只出下层（打印用，落在 z=0 平面）
//       "upper"    → 只出上层（打印用，落在 z=0 平面）
//
// ★ 关键规则（踩过的坑）：
//   1. addons 必须写在【各层的 module 内部】，不能写在顶层
//      —— 否则 "upper" 导出时会带着下层的夹爪 ✗
//   2. 每层单独导出时，必须**自己从 z=0 开始长** ✓
//   3. 每层导出后检查 **Simple: yes** ✓
//   4. 墙上的沉台要 rotate 一下（我的 pocket 默认沿 -z 挖）
//=============================================================================

include <body_v4_addons.scad>      // 7 个可插入模块

// ---------------- 输出选择 ----------------
PART = "assembly";   // "assembly" | "lower" | "upper"
SHOW_DEMO = false;

// ---------------- 尺寸 ----------------
// （和 v3 对齐，缩小后）
// L=225 W=125 H1=45 H2=50 WALL=3 FLOOR=3  已在 addons 里定义

//=============================================================================
// 下层（打印时 z 从 0 开始）
//   放：电池、电机驱动板、5.5V 降压、端子排、超声波（前壁）
//=============================================================================
module lower_body() {
    difference() {
        union() {
            // ---- 盒子本体（你队友 v3 里已有，这里只画个示意）----
            cube([L, W, H1], center = true);          // 外壳（示意）
            // ---- 挡件安装座 ×4（装在侧壁外面）----
            for (sx = [-1, 1])
                for (sz = [-1, 1])
                    translate([sx*(L/2 - 22), sz*(W/2), 0])
                        rotate([0, 0, sz > 0 ? 0 : 180])
                            stop_boss(16, 6, 14);
        }
        // ---- 掏空内腔（示意）----
        translate([0, 0, FLOOR])
            cube([L - 2*WALL, W - 2*WALL, H1 + 10], center = true);
        translate([0, 0, FLOOR/2])
            cube([L - 2*WALL, W - 2*WALL, FLOOR + 0.01], center = true);

        // ---- 超声波矩形沉台（前壁，从内表面往墙里挖）----
        translate([-(L/2 - WALL), 0, 25])
            rotate([0, -90, 0]) rect_pocket(46, 21, 2);

        // ---- 扎带孔阵列（底板）----
        translate([0, 0, 0]) zip_grid(4, 2, 30, 16);

        // ---- 挡件底孔 ×4 ----
        for (sx = [-1, 1])
            for (sz = [-1, 1])
                translate([sx*(L/2 - 22), sz*(W/2), 0])
                    rotate([0, 0, sz > 0 ? 0 : 180])
                        stop_boss_holes(16, 6, 9);
    }
}

//=============================================================================
// 上层（打印时同样 z 从 0 开始）
//   放：FPGA、K230、充电宝不放这（绑后壁外面）、9V 降压
//=============================================================================
module upper_body() {
    difference() {
        union() {
            cube([L, W, H2], center = true);          // 外壳（示意）
            // ---- FPGA 四角 L 边夹 ----
            for (sx = [-1, 1])
                for (sy = [-1, 1])
                    translate([-34 + sx*50, sy*30, FLOOR])
                        rotate([0, 0, sy > 0 ? 0 : 180])
                            board_clamp();
        }
        // ---- 掏空 ----
        translate([0, 0, FLOOR])
            cube([L - 2*WALL, W - 2*WALL, H2 + 10], center = true);
        translate([0, 0, FLOOR/2])
            cube([L - 2*WALL, W - 2*WALL, FLOOR + 0.01], center = true);

        // ---- 摄像头方形沉台（前壁，要 rotate 让挖的方向朝墙里）----
        translate([L/2 - WALL, 0, 22])
            rotate([0, 90, 0]) square_pocket(26, 2, 14);

        // ---- 扎带孔阵列 ----
        zip_grid(4, 2, 30, 16);
    }
}

//=============================================================================
// 统一装配（检查干涉用）
//=============================================================================
module assembly() {
    color([0.85, 0.88, 0.95]) lower_body();
    translate([0, 0, H1 + FLOOR])
        color([0.95, 0.90, 0.82]) upper_body();
}

//=============================================================================
// 输出选择
//=============================================================================
if (PART == "assembly")      assembly();
else if (PART == "lower")    lower_body();
else if (PART == "upper")    upper_body();
else echo("PART 只能是 assembly / lower / upper");
