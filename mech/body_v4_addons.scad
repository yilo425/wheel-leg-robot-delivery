//=============================================================================
// body_v4_addons.scad —— 车身 v4 的"可插入模块"
//
// ★ 用法：**不要重写 body_v3.scad** ✗
//   把本文件的内容拷到 body_v3.scad 末尾，然后在需要的地方调用下面这些
//   module —— 加在 difference() 外面（实体）或里面（开孔）都行。
//
//   设计原则沿用你们 v3 的：
//     · 优先"形状互锁"，不用弹性变形（卡扣会断）
//     · 竖直生长的细小特征不许承力
//     · 大面朝下打印
//
// 坐标约定（和 body_v3 一致）：
//   x = 前后（+x 向前）, y = 左右, z = 高度（0 = 下层底面）
//   内腔：x ∈ [-(L/2-WALL), +(L/2-WALL)]，y ∈ [-(W/2-WALL), +(W/2-WALL)]
//=============================================================================

// ---------------- 车身参数（和 body_v3 对齐）----------------
WALL  = 3;
FLOOR = 3;
L     = 225;      // 缩小后
W     = 125;
H1    = 45;
H2    = 50;
IN_X  = L/2 - WALL;
IN_Y  = W/2 - WALL;

BOARD_T = 1.6;    // 板厚（FPGA / K230 都约 1.6）
M3_TAP  = 2.8;    // M3 自攻底孔
$fn = 32;

//=============================================================================
// 1) L 形边夹 —— 夹住板边（不依赖安装孔）
//
//   立于底板上，顶部有个向内的"爪"，板从侧面滑进去被压住。
//   hook=true 时爪更长（滑入式）；false 时是纯挡边。
//
//   用法：在底板上放 4 个，两两相对，夹住板的两条对边。
//=============================================================================
module board_clamp(t = BOARD_T, h = 7, reach = 4, th = 2.5, hook = true) {
    gap = 0.3;                       // 板与爪的间隙（宁松勿紧）
    union() {
        // 竖柱（立在底板上，z 从 0 开始）
        cube([th, th, h + t + gap]);
        // 顶部爪：从柱子向 -y 方向伸，压住板的上表面
        translate([0, -reach, h + gap])
            cube([th, th + reach, t]);
        if (hook) {
            // 滑入斜角（导向，板一推就进去）
            translate([0, -reach, h + gap])
                rotate([0, 45, 0])
                    cube([th, th + reach, th]);
        }
    }
}

//=============================================================================
// 2) 扎带孔对 —— 2 个腰形孔 + 中间留桥
//
//   任何模块都能用扎带绑住（后买的降压模块尺寸未知也能装 ✓）
//   从底板穿透（z 方向），跨度 span，孔径 w。
//=============================================================================
module zip_slots(span = 16, w = 3, l = 6, z0 = 0, h = FLOOR) {
    for (sx = [-1, 1])
        translate([sx*span/2 - l/2, -w/2, z0 - 0.01])
            cube([l, w, h + 0.02]);
}

// 扎带孔阵列（底板上一排，间距 pitch）
module zip_grid(nx = 5, ny = 3, pitch = 20, span = 16, z0 = 0) {
    for (ix = [0 : nx-1])
        for (iy = [0 : ny-1])
            translate([(ix - (nx-1)/2) * pitch, (iy - (ny-1)/2) * pitch, 0])
                zip_slots(span = span, z0 = z0);
}

//=============================================================================
// 3) 卡槽/兜 —— 3 面挡边 + 一面开口（模块从开口滑进去）
//
//   用于：电池、充电宝、降压模块（尺寸不确定的都能卡）
//   内腔 = W × D，壁厚 th，高 h
//=============================================================================
module cradle(Wi = 40, Di = 20, h = 12, th = 2, open_dir = "y+") {
    // 底板
    cube([Wi + 2*th, Di + 2*th, th]);
    // 三面墙（按 open_dir 省一面）
    if (open_dir != "x-") translate([-th, 0, 0]) cube([th, Di + 2*th, h]);
    if (open_dir != "x+") translate([Wi, 0, 0])  cube([th, Di + 2*th, h]);
    if (open_dir != "y-") translate([0, -th, 0]) cube([Wi + 2*th, th, h]);
    if (open_dir != "y+") translate([0, Di, 0])  cube([Wi + 2*th, th, h]);
}

//=============================================================================
// 4) 方形沉台 —— 摄像头（方形模块，掉不出来）
//
//   从【内表面】往墙里挖 depth 深、size × size 的方形坑，四角 R2。
//   中间再开一个圆通孔让镜头看出去（light_d）。
//   用法（放在 difference() 里）：
//     translate([x, y, z_wall_inner]) square_pocket(26, 2, 14);
//=============================================================================
module square_pocket(size = 26, depth = 2, light_d = 14) {
    r = 2;
    translate([0, 0, -0.01])
        hull() {
            for (sx = [-1, 1], sy = [-1, 1])
                translate([sx*(size/2 - r), sy*(size/2 - r), 0])
                    cylinder(r = r, h = depth + 0.01);
        }
    // 让镜头看出去的通孔（穿墙）
    translate([0, 0, -depth - 50])
        cylinder(d = light_d, h = 200);
}

//=============================================================================
// 5) 矩形沉台 —— 超声波 HC-SR04（孔尺寸不变，只加台阶防脱）
//=============================================================================
module rect_pocket(px = 46, py = 21, depth = 2) {
    translate([-px/2, -py/2, -0.01])
        cube([px, py, depth + 0.01]);
}

//=============================================================================
// 6) 挡件安装座 —— 侧壁外侧加厚 + 2 个自攻底孔
//
//   舵机是"穿墙式"，腿在【墙外】→ 挡件必须装在墙外 ✗
//   所以在侧壁外面加一块 16×14×6 的凸台，再开 2 个 φ2.8 底孔。
//
//   用法（实体，加在 difference() 外面）：
//     translate([x, ±(W/2), z]) stop_boss();
//   孔（放在 difference() 里）用 stop_boss_holes()
//=============================================================================
module stop_boss(w = 16, d = 6, h = 14) {
    // 贴墙的那个面在 y=0，往外（+y）长 d
    translate([-w/2, 0, -h/2])
        cube([w, d, h]);
    // 根部过渡（避免 90° 应力集中）
    translate([-w/2, -1.5, -h/2])
        cube([w, 1.5, h]);
}

module stop_boss_holes(w = 16, d = 6, pitch = 9) {
    // 2 个水平孔，从外侧打进墙
    for (sx = [-1, 1])
        translate([sx*pitch/2, d + 0.01, 0])
            rotate([90, 0, 0])
                cylinder(d = M3_TAP, h = d + WALL + 3);
}

//=============================================================================
// 7) 可调卡槽 —— 底板浅槽 + 2 个滑动 L 夹块
//
//   后买的降压模块尺寸未知？先用浅槽定位，再用 2 个夹块（M3 锁）夹住
//=============================================================================
module slot_channel(len = 120, wid = 8, dep = 1.5) {
    translate([-len/2, -wid/2, -0.01])
        cube([len, wid, dep + 0.01]);
}

module slider_clamp(h = 12, th = 3, tab = 5) {
    difference() {
        union() {
            cube([th, tab, h]);                       // 竖块
            translate([0, 0, h - tab])
                cube([th, tab * 2.2, tab]);           // 顶部压爪
        }
        // M3 长孔（锁紧用）
        translate([th/2, tab/2, h * 0.45])
            rotate([90, 0, 0])
                cylinder(d = 3.4, h = tab * 2 + 2, center = true);
    }
}

//=============================================================================
// 8) 演示：把上面几个拼一下，F5 看效果（交付时删掉或 SHOW_DEMO=false）
//=============================================================================
SHOW_DEMO = true;

if (SHOW_DEMO) {
    // 一块 120×80 的假底板
    difference() {
        translate([-60, -40, -FLOOR]) cube([120, 80, FLOOR]);
        // 扎带孔阵列
        translate([0, 0, -FLOOR]) zip_grid(nx = 4, ny = 2, pitch = 30, span = 16);
        // 摄像头方形沉台（挖在右下角）
        translate([45, -30, -0.01]) square_pocket(26, 2, 14);
        // 超声波矩形沉台（挖在左下角）
        translate([-45, -30, -0.01]) rect_pocket(46, 21, 2);
        // 挡件底孔
        translate([-55, 35, -FLOOR]) stop_boss_holes();
    }
    // 4 个 L 边夹（夹一块 100×60 的假板）
    for (sx = [-1, 1], sy = [-1, 1])
        translate([sx*50, sy*30, -FLOOR + 0])
            rotate([0, 0, (sy > 0) ? 0 : 180])
                board_clamp();
    // 电池兜
    translate([-45, 5, 0]) cradle(88, 61, 12, 2, "y+");
    // 降压模块卡槽
    translate([40, 20, 0]) slot_channel(120, 8, 1.5);
    translate([10, 20, 0]) slider_clamp();
    translate([30, 20, 0]) rotate([0, 0, 180]) slider_clamp();
}
