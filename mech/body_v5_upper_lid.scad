//=============================================================================
// body_v5_upper_lid.scad —— 二层外包盖（扣在车身二层顶部）
//
// 设计要点（2026-11-01）
//   1. ★ 宁松勿紧：单边间隙 0.5mm（怕扣不上），底部再倒 2mm 斜角做导入
//   2. 只盖顶部 12mm 高（二层高 50，模块最高 34，留 4mm 余量不压线）
//   3. ★ 前缘开摄像窗：摄像头在 x≈112~115、y=0，窗宽 40 全高打通，绝不挡视野
//   4. 顶部开散热槽（FPGA/K230 会热）
//   5. 左右各一个外凸小耳（你手绘图上的两个"耳朵"），方便取下
//   6. 内角 R10（车身圆角 R8 + 2 余量，避免卡角扣不上）
//
// 打印：PETG 或 PLA，0.2 层高，壁 3 圈，填充 15%，不加支撑，brim 5
//=============================================================================

PART = "lid";        // "lid" | "check"（check 显示车身位置做校对）

// ---------------- 车身二层（body_v5.scad）----------------
L      = 242;        // 二层外长
W      = 150;        // 二层外宽
H2     = 50;         // 二层总高
WALL   = 3;
CR_BODY = 8;         // 车身圆角

// ---------------- 盖子参数 ----------------
CLR      = 0.5;      // ★ 单边间隙（怕扣不上，宁松勿紧；太松就改 0.3）
WALL_L   = 2.5;      // 盖壁厚
RIM_H    = 12;       // 裙边高度（只盖顶部 12mm）
TOP_T    = 2.5;      // 顶板厚度
CR_LID   = CR_BODY + 2;   // 盖内圆角（比车身大 2，避免卡角）
CHAMFER  = 2;        // 底部导入斜角

// ---------------- 摄像头窗口 ----------------
CAM_X    = 112;      // 摄像头中心 x（前缘 = +x）
CAM_W    = 40;       // 窗口宽度（摄像头 26 宽 + 两侧各 7 余量）
CAM_Y    = 0;

// ---------------- 散热槽 ----------------
VENT_N   = 5;
VENT_W   = 6;
VENT_L   = 90;
VENT_SP  = 18;

// ---------------- 耳朵 ----------------
EAR_W    = 14;
EAR_T    = 3;
EAR_OUT  = 5;

$fn = 32;


//-----------------------------------------------------------------------------
// 圆角矩形柱
//-----------------------------------------------------------------------------
module rrect(l, w, r, h) {
    hull() {
        for (x = [-l/2 + r, l/2 - r], y = [-w/2 + r, w/2 - r])
            translate([x, y, 0]) cylinder(r = r, h = h);
    }
}

//-----------------------------------------------------------------------------
// 盖子主体
//-----------------------------------------------------------------------------
module lid() {
    outer_l = L + 2 * (CLR + WALL_L);
    outer_w = W + 2 * (CLR + WALL_L);
    inner_l = L + 2 * CLR;
    inner_w = W + 2 * CLR;

    difference() {
        // ---- 外壳（顶板 + 裙边一体）----
        rrect(outer_l, outer_w, CR_LID, RIM_H + TOP_T);

        // ---- 内腔（从底部往上挖，留 TOP_T 做顶板）----
        translate([0, 0, -0.1])
            rrect(inner_l, inner_w, CR_LID, RIM_H + 1);

        // ---- 底部导入斜角：把内腔底部做成锥形，方便对准扣上 ----
        translate([0, 0, -0.1])
            rrect(inner_l + 2 * CHAMFER, inner_w + 2 * CHAMFER, CR_LID, CHAMFER + 0.1);
        // 上面这刀是把"底部 2mm 的内腔"挖大一点，形成 2mm 倒角

        // ---- 摄像头窗口：前壁 + 顶板前缘一起开，确保视野不被挡 ----
        translate([L / 2 - 8, CAM_Y - CAM_W / 2, -1])
            cube([24, CAM_W, RIM_H + TOP_T + 2]);

        // ---- 顶部散热槽 ----
        for (i = [0 : VENT_N - 1]) {
            translate([-VENT_L / 2 + i * (VENT_L / (VENT_N - 1)) - VENT_W / 2,
                       -VENT_W / 2, RIM_H + TOP_T - 1.2])
                cube([VENT_W, VENT_W, TOP_T + 2]);
        }
    }

    // ---- 两侧外凸耳朵（取下时着力）----
    for (s = [-1, 1]) {
        translate([0, s * (outer_w / 2 + EAR_OUT / 2 - 1.5), RIM_H / 2 - EAR_W / 2])
            difference() {
                cube([EAR_T * 2, EAR_OUT, EAR_W], center = true);
                // 内侧留个圆弧过渡（简化：不倒角）
            }
    }
}

//-----------------------------------------------------------------------------
// 校对：车身二层（半透明）
//-----------------------------------------------------------------------------
module body_check() {
    color([0.4, 0.6, 0.9, 0.25])
        translate([0, 0, -(H2 - RIM_H)])
            difference() {
                rrect(L, W, CR_BODY, H2);
                translate([0, 0, WALL]) rrect(L - 2 * WALL, W - 2 * WALL, CR_BODY - WALL, H2);
            }
    // 摄像头占位
    color([1, 0.3, 0.3, 0.6])
        translate([CAM_X, CAM_Y, -(H2 - RIM_H) + 34])
            cube([6, 26, 12], center = true);
}

//-----------------------------------------------------------------------------
if (PART == "lid") {
    lid();
} else {
    lid();
    body_check();
}
