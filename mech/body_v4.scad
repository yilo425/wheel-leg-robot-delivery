//=============================================================================
// body_v4.scad —— 轮足机器人车身 v4（完整版：两层 + 所有固定结构）
//
// ★ 一个文件三种输出（改下面 PART 一行）：
//     PART = "assembly"  → 两层叠起来（检查干涉）
//     PART = "lower"     → 只出下层（打印，落在 z=0）
//     PART = "upper"     → 只出上层（打印，落在 z=0）
//
// ★ v4.1 本轮改动（按队友反馈）：
//   1. 【固定桩】从 ±100,±68 挪到 ±55,±55 —— 原位置落在舵机穿墙区里，
//      而且是悬空的 8mm 短柱（没连到底板）。现在改成【从底板长到顶 + 高出 8mm】的实心桩。
//   2. 【边夹】修了爪高 bug：原来爪在 z=9.3mm，板厚才 1.6mm，根本夹不到。
//      现在爪压在板上表面（z=板厚+0.3）。
//   3. 【底层分区】加 2 道矮墙：电池区 | 驱动区 | 降压/端子区，一眼看清。
//   4. 【模块固定】电机驱动板 50×50 四角 L 夹；降压/端子排用扎带孔兜底（尺寸未知也能绑）。
//   5. 【舵机孔】一字未动（穿墙孔 + 耳孔 + 加强板原样保留）。
//
// 打印：PETG / 0.2 / 壁 3 圈 / 填充 15% / 不加支撑 / brim 5mm
//=============================================================================

// ---------------- 输出选择 ----------------
PART = "assembly";        // "assembly" | "lower" | "upper"
SHOW_HELPERS = false;     // true 时显示模块占位块（检查干涉）

// ---------------- 车身 ----------------
L     = 225;              // 外形长（原 250）
W     = 150;              // ★ 外形宽（不能缩！舵机穿墙占位）
H1    = 45;               // 下层高
H2    = 50;               // 上层高
WALL  = 3;
FLOOR = 3;
CR    = 8;                // 竖直角半径

// ---------------- 舵机（实测）----------------
SV_X   = 85;              // 前后位置（±）
ZV     = 26;              // 轴心高（从层底算）
SV_HW  = 42;              // 穿墙孔 X 向（本体 40.7 + 0.65/边）
SV_HH  = 21;              // 穿墙孔 Z 向（本体 19.7 + 0.65/边）
EAR_DX = 49;              // 耳孔：长方向（沿 X）
EAR_DY = 10.5;            // 耳孔：窄方向（沿 Z）
EAR_D  = 3.2;             // 耳孔 φ
BOSS_W = 15;              // 内侧加强板（X 向）
BOSS_H = 42;              // 内侧加强板（Z 向）
BOSS_T = 6;               // 内侧加强板厚（M3 自攻吃 6mm）

// ---------------- 上下层连接 ----------------
POST_D = 10;              // 固定桩直径
PILOT  = 2.6;             // M3 自攻底孔
POST_X = 55;              // ★ 固定桩位置（±）—— 从 100 改 55（避开舵机穿墙区 x∈64..106）
POST_Y = 55;              // ★ 固定桩位置（±）—— 从 68 改 55（避开舵机穿墙区 y∈32..75）

// ---------------- 模块尺寸（实测/估计）----------------
FX = 140;  FY = 92;  FH = 34;   // FPGA
KX = 56;   KY = 85;            // K230（转 90° 放，估）
BATT_L = 91;  BATT_W = 64;  BATT_D = 4;   // 电池浅槽
DRV        = 50;               // 电机驱动板 50×50
DRV_CX = 32;  DRV_CY = -40;    // 驱动板中心（前左区）
SR04_W = 46;  SR04_H = 21;     // 超声波孔
CAM_S = 26;  CAM_LIGHT = 14;  CAM_DEP = 2;  // 摄像头方形沉台

// ---------------- 其它 ----------------
TIE_SPAN = 16;            // 扎带孔长
TIE_W    = 3;             // 扎带孔宽
MOTOR_HOLE = [16, 24];    // 电机线孔 X×Y（6 排线 + 白色插头，头大）
$fn = 48;

//=============================================================================
// 基础：圆角盒子（开口朝上）
//=============================================================================
module shell(len, wid, hgt, fl = FLOOR, wl = WALL, cr = CR) {
    difference() {
        linear_extrude(height = hgt)
            offset(r = cr) square([len - 2*cr, wid - 2*cr], center = true);
        translate([0, 0, fl])
            linear_extrude(height = hgt)
                offset(r = cr - wl) square([len - 2*cr - 2*wl, wid - 2*cr - 2*wl], center = true);
    }
}

//=============================================================================
// 舵机穿墙孔 + 耳孔 + 内侧加强板（下层，4 处）—— ★ 本轮一字未动
//   sx = ±1（前后）  sy = ±1（左右）
//=============================================================================
module servo_cut(sx, sy) {
    // 穿墙孔：X × Z，居中在 (sx*SV_X, sy*(W/2))
    translate([sx*SV_X, sy*W/2, ZV])
        cube([SV_HW, WALL + 6, SV_HH], center = true);
    // 4 个耳孔（在外壁外侧，穿透墙 + 加强板）
    for (ex = [-1, 1], ez = [-1, 1])
        translate([sx*SV_X + ex*EAR_DX/2, sy*W/2, ZV + ez*EAR_DY/2])
            rotate([90, 0, 0])
                cylinder(d = EAR_D, h = WALL + BOSS_T + 4, center = true);
}

module servo_boss(sx, sy) {
    // 内壁上的加强板（15 × 6 × 42），螺丝从这里吃进去
    translate([sx*SV_X, sy*(W/2 - WALL - BOSS_T/2), ZV])
        cube([BOSS_W, BOSS_T, BOSS_H], center = true);
}

//=============================================================================
// 挡件安装座（侧壁外面，4 处）—— 本轮一字未动
//   腿在墙外 → 挡件必须装外面；用 2× M3 自攻打进这块 16×14×6 的凸台
//=============================================================================
module stop_boss(sx, sy) {
    translate([sx*(SV_X - 30), sy*(W/2 + 3), 30])
        cube([16, 6, 14], center = true);
}
module stop_boss_holes(sx, sy) {
    for (ex = [-1, 1])
        translate([sx*(SV_X - 30) + ex*4.5, sy*(W/2 + 3), 30])
            rotate([90, 0, 0])
                cylinder(d = 2.8, h = 6 + WALL + 3, center = true);
}

//=============================================================================
// 扎带孔（底板穿透，从 z0 往下挖）
//=============================================================================
module zip_grid(nx, ny, pitch, z0) {
    for (ix = [0 : nx-1], iy = [0 : ny-1])
        for (s = [-1, 1])
            translate([(ix - (nx-1)/2)*pitch + s*TIE_SPAN/2, (iy - (ny-1)/2)*pitch, z0 - 1])
                cube([6, TIE_W, FLOOR + 2], center = true);
}

// 单对扎带孔（跨 span，居中）
module zip_pair(span = TIE_SPAN) {
    for (s = [-1, 1])
        translate([s*span/2, 0, -1])
            cube([6, TIE_W, FLOOR + 2], center = true);
}

//=============================================================================
// L 形边夹 —— 夹住平放在底板上的板（厚 t）
//
// ★ 修复：爪高度 = 板厚 + 0.3（压在板上表面），不再悬空。
//   局部坐标：板边在 y=0，爪朝 -y 方向伸 reach 深压住板。
//=============================================================================
module board_clamp(t = 1.6, reach = 6, th = 4.0, gap = 0.3) {
    translate([-th/2, 0, 0]) {
        // 竖柱：从底板到略高于板上表面
        cube([th, th, t + gap + t]);
        // 爪：从柱顶向 -y 伸，压在板上表面
        translate([0, -reach, t + gap])
            cube([th, th + reach, t]);
    }
}

// 在一块板（中心 cx,cy，尺寸 bx×by）四周放 4 个边夹：上下两边各 2 个
module clamp_rect(cx, cy, bx, by, t = 1.6, reach = 6, th = 4.0) {
    for (sx = [-1, 1], sy = [-1, 1])
        translate([cx + sx*(bx/2 - reach), cy + sy*(by/2), FLOOR])
            rotate([0, 0, sy > 0 ? 0 : 180])
                board_clamp(t, reach, th);
}

//=============================================================================
// 电池兜（3 面挡边 + 开口朝 +y，用扎带压住）
//=============================================================================
module batt_cradle(cx, cy) {
    wi = BATT_L; di = BATT_W; th = 2; h = 14;
    translate([cx - wi/2 - th, cy - di/2 - th, FLOOR])
        difference() {
            cube([wi + 2*th, di + 2*th, h]);
            translate([th, th, th]) cube([wi, di, h + 1]);
            // 开口朝 +y
            translate([th, di, 0]) cube([wi, th + 1, h + 1]);
        }
}

//=============================================================================
// 分区矮墙（len × th × hgt，中心定位）
//=============================================================================
module divider(len, th = 2, hgt = 10) {
    cube([len, th, hgt], center = true);
}

//=============================================================================
// 下层
//   分区：后=电池区 | 前左=电机驱动板 | 前右=降压 + 端子排
//   舵机 4 个穿侧墙
//=============================================================================
module lower_body() {
    difference() {
        union() {
            shell(L, W, H1);
            // 4 个舵机加强板（未动）
            for (sx = [-1, 1], sy = [-1, 1]) servo_boss(sx, sy);
            // 4 个挡件安装座（未动）
            for (sx = [-1, 1], sy = [-1, 1]) stop_boss(sx, sy);
            // 电池兜
            batt_cradle(-45, 0);
            // ★ 固定桩 ×4：从底板长到顶，再高出 8mm 给上层定位
            for (sx = [-1, 1], sy = [-1, 1])
                translate([sx*POST_X, sy*POST_Y, 0])
                    cylinder(d = POST_D, h = H1 + 8);
            // ★ 分区矮墙 ×2（区块分划）
            //   竖墙：隔开 电池区 | 前部电子区
            translate([4, 0, FLOOR + 5]) divider(120, 2, 10);
            //   横墙：隔开 驱动区 | 降压/端子区
            translate([34, -5, FLOOR + 5]) divider(60, 2, 10);
            // ★ 电机驱动板 50×50 四角边夹（模块固定）
            clamp_rect(DRV_CX, DRV_CY, DRV, DRV);
        }

        // ---- 舵机穿墙孔 ×4（未动）----
        for (sx = [-1, 1], sy = [-1, 1]) servo_cut(sx, sy);

        // ---- 挡件底孔 ×4（未动）----
        for (sx = [-1, 1], sy = [-1, 1]) stop_boss_holes(sx, sy);

        // ---- 固定桩自攻底孔（从桩顶往下钻）----
        for (sx = [-1, 1], sy = [-1, 1])
            translate([sx*POST_X, sy*POST_Y, H1 - 2])
                cylinder(d = PILOT, h = 12);

        // ---- 电机线孔 ×4（底板边缘，6 排线用）----
        for (sx = [-1, 1], sy = [-1, 1])
            translate([sx*(SV_X - 20), sy*(W/2 - WALL - MOTOR_HOLE[0]/2 + 2), -1])
                cube([MOTOR_HOLE[0], MOTOR_HOLE[1], FLOOR + 2]);

        // ---- 超声波矩形沉台（前壁内表面往里挖）----
        translate([-(L/2 - WALL), 0, 24])
            rotate([0, -90, 0]) {
                translate([-SR04_W/2, -SR04_H/2, -0.01])
                    cube([SR04_W, SR04_H, 2.01]);
            }
        // ---- 超声波通孔（穿墙）----
        translate([-(L/2 - WALL), 0, 24])
            rotate([0, -90, 0])
                translate([-45/2, -20/2, 2])
                    cube([45, 20, WALL + 4]);

        // ---- 扎带孔：电池区（兜内再加绑带）----
        translate([-45, 0, 0]) zip_grid(3, 2, 30, 0);
        // ---- 扎带孔：降压 + 端子排区（尺寸未知也能绑）----
        translate([35, 30, 0]) zip_grid(2, 3, 22, 0);

        // ---- 通风孔 ----
        for (ix = [-3 : 3], iy = [-2 : 2])
            translate([ix*28, iy*24, -1])
                cylinder(d = 5, h = FLOOR + 2);
    }
}

//=============================================================================
// 上层
//   放：FPGA（后）+ K230（前，转 90°）+ 9V 降压
//   前壁：摄像头方形沉台
//=============================================================================
module upper_body() {
    difference() {
        union() {
            shell(L, W, H2);
            // FPGA 四角边夹（用修好的 clamp_rect）
            clamp_rect(-34, 0, FX, FY);
            // K230 四角边夹
            clamp_rect(78, -12, KX, KY);
        }

        // ---- 固定桩过孔（上层底板，φ3.4）----
        for (sx = [-1, 1], sy = [-1, 1])
            translate([sx*POST_X, sy*POST_Y, -1])
                cylinder(d = 3.4, h = FLOOR + 2);

        // ---- FPGA DC 电源孔（前边缘外侧 14×40）----
        translate([-34 + FX/2 + 10, 0, -1])
            cube([14, 40, FLOOR + 2]);

        // ---- 摄像头：方形沉台（前壁内表面）+ φ14 通孔 ----
        translate([L/2 - WALL, 0, 26])
            rotate([0, 90, 0]) {
                translate([0, 0, -0.01])
                    hull()
                        for (sx = [-1, 1], sy = [-1, 1])
                            translate([sx*(CAM_S/2 - 2), sy*(CAM_S/2 - 2), 0])
                                cylinder(r = 2, h = CAM_DEP + 0.01);
                translate([0, 0, -WALL - 2])
                    cylinder(d = CAM_LIGHT, h = WALL + 3);
            }

        // ---- 扎带孔阵列 ----
        zip_grid(4, 2, 30, 0);

        // ---- 通风孔 ----
        for (ix = [-3 : 3], iy = [-2 : 2])
            translate([ix*28, iy*24, -1])
                cylinder(d = 5, h = FLOOR + 2);

        // ---- 层间走线长孔 ×2 ----
        for (sx = [-1, 1])
            translate([sx*30, 0, -1])
                cube([60, 10, FLOOR + 2]);
    }
}

//=============================================================================
// 装配（检查干涉）
//=============================================================================
module assembly() {
    color([0.86, 0.90, 0.96]) lower_body();
    translate([0, 0, H1 + FLOOR + 0.2])
        color([0.96, 0.92, 0.84]) upper_body();
    // 充电宝绑在后壁外面（示意）
    if (SHOW_HELPERS)
        color([0.95, 0.95, 0.75])
            translate([-L/2 - 30, 0, H1/2])
                cube([27, 79, 35], center = true);
}

//=============================================================================
// 输出
//=============================================================================
if (PART == "assembly")       assembly();
else if (PART == "lower")     lower_body();
else if (PART == "upper")     upper_body();
else                          echo("!! PART 只能是 assembly / lower / upper");
