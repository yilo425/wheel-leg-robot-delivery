//=============================================================================
// stop_block_lib.scad —— 挡件【只有参数 + 模块】，顶层不画东西
//
// 为什么单独拆出这个文件：
//   OpenSCAD 的 `use <file>` **只导入模块/函数，不导入顶层变量**。
//   挡件的 stop_block() 依赖 W/D/H/SLOT_* 这些顶层参数，用 `use` 会读成 0，
//   几何直接退化。所以拆成 lib，让需要它的文件用 `include`（参数一起进来），
//   而 lib 顶层没有任何几何 -> 不会在别的文件里冒出多余零件。
//
// 单独打印挡件请用 stop_block.scad（它 include 本文件并排 4 个）。
//=============================================================================

// ---------------- 参数 ----------------
W        = 14;    // X：沿腿摆动方向（接触宽度）
D        = 10;    // Y：伸出墙外的厚度（也是螺丝穿过的长度）
H        = 30;    // Z：总高（调节范围靠中间的长槽）
RUB_T    = 3;     // 橡胶垫厚度
LIP      = 1.2;   // 橡胶槽挡边
SLOT_W   = 3.4;   // M3 过孔宽（φ3.4 = M3 松配合）
SLOT_L   = 16;    // 竖向长槽长度 = 高度可调范围
SLOT_Z0  = 8;     // 长槽下端离底面
SCREW_Y  = 4.5;   // 两孔中心 ±（与车身凸台一致）
CH       = 1.0;   // 顶边倒角

$fn = 32;

//=============================================================================
module stop_block() {
    difference() {
        // 主体
        cube([W, D, H]);

        // 2 个竖向长槽（沿 Y 贯穿、沿 Z 可调）——松开螺丝上下滑
        for (sx = [-1, 1])
            translate([W/2 + sx*SCREW_Y, 0, SLOT_Z0])
                hull() {
                    translate([0, -0.02, 0])     rotate([-90, 0, 0]) cylinder(d = SLOT_W, h = D + 0.04);
                    translate([0, -0.02, SLOT_L]) rotate([-90, 0, 0]) cylinder(d = SLOT_W, h = D + 0.04);
                }

        // 底面橡胶槽（四周留 LIP 挡边，橡胶塞进去不会掉）
        translate([LIP, LIP, -0.01])
            cube([W - 2*LIP, D - 2*LIP, RUB_T + 0.01]);
    }
}
